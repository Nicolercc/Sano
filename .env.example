# Copy to .env.local and fill in values. Never commit real values.
# Every variable is optional: without Supabase settings the app serves the
# committed NYC DOHMH extract in data/official-restaurants.json.

# App (lib/server/restaurants.ts): optional Supabase data layer.
# Either key works; the service role key is used if both are set.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Data scripts only (scripts/enrich_google_places.py).
GOOGLE_PLACES_API_KEY=

# Acceptance script only (scripts/acceptance.mjs). Defaults to http://127.0.0.1:3000.
SANO_BASE_URL=
