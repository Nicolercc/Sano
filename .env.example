# Sano runs with no environment variables: it serves the committed NYC DOHMH
# extract in data/official-restaurants.json. Everything below is optional.

# Supabase data layer (optional). When both URL and a key are set, the app
# reads restaurant_records from Supabase and falls back to the committed seed
# on any error or timeout.
SUPABASE_URL=
# Read-only key for the app. Prefer the anon key with a read-only RLS policy.
SUPABASE_ANON_KEY=
# Server-side only. Used by scripts/load_supabase_restaurants.py to write
# records; the app also accepts it, but it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Google Places enrichment (optional, scripts/enrich_google_places.py only).
GOOGLE_PLACES_API_KEY=

# Base URL for `npm run acceptance` (defaults to http://localhost:3000).
SANO_BASE_URL=
