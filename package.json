{
  "name": "sano",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "validate:official": "python3 scripts/validate_restaurant_seed.py data/official-restaurants.json --kind official",
    "validate:synthetic": "python3 scripts/validate_restaurant_seed.py data/sample-restaurants.json --kind synthetic",
    "check": "npm run validate:official && npm run validate:synthetic && npm run lint && npm run build",
    "acceptance": "node scripts/acceptance.mjs",
    "enrich:google:dry-run": "python3 scripts/enrich_google_places.py --dry-run",
    "enrich:google": "python3 scripts/enrich_google_places.py"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3"
  }
}
