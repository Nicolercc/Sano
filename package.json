{
  "name": "sano",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "validate:official": "python3 scripts/validate_restaurant_seed.py data/official-restaurants.json --kind official",
    "validate:synthetic": "python3 scripts/validate_restaurant_seed.py data/sample-restaurants.json --kind synthetic",
    "a11y:regression": "node scripts/a11y-regression-check.mjs",
    "a11y:contrast": "node scripts/a11y-contrast-check.mjs",
    "a11y": "npm run a11y:regression && npm run a11y:contrast",
    "check": "npm run validate:official && npm run validate:synthetic && npm run lint && npm run a11y && npm run build",
    "acceptance": "node scripts/acceptance.mjs",
    "enrich:google:dry-run": "python3 scripts/enrich_google_places.py --dry-run",
    "enrich:google": "python3 scripts/enrich_google_places.py",
    "generate:supabase-seed": "python3 scripts/score_restaurants.py --input data/generated/normalized-inspections.json --output data/generated/supabase-restaurants.json --provenance-output data/generated/supabase-provenance.json --limit 1000 --min-inspections 2",
    "load:supabase:dry-run": "python3 scripts/load_supabase_restaurants.py --dry-run",
    "load:supabase": "python3 scripts/load_supabase_restaurants.py"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3"
  }
}
